#!/usr/bin/env bash
set -uo pipefail
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/tags/*)
            tag="${local_ref#refs/tags/}"
            head_sha="$(git rev-parse HEAD 2>/dev/null || echo '')"
            tag_sha="$(git rev-parse "refs/tags/${tag}^{commit}" 2>/dev/null || echo '')"
            if [ -z "$tag_sha" ]; then
                printf '\nBLOCKED: cannot resolve tag %s to a commit.\n' "$tag" >&2
                fail=1
                continue
            fi
            if [ "$tag_sha" != "$head_sha" ]; then
                behind="$(git rev-list --count "${tag_sha}..HEAD" 2>/dev/null || echo '?')"
                printf '\nBLOCKED: tag %s does not point at HEAD.\n' "$tag" >&2
                printf '  tag  -> %s\n' "${tag_sha:0:7}" >&2
                printf '  HEAD -> %s  (%s commit(s) ahead)\n' "${head_sha:0:7}" "$behind" >&2
                printf '\n  Pushing this would publish a different build than the one tested.\n' >&2
                printf '  Fix:  git tag -d %s && git tag -a %s -m "<message>"\n\n' "$tag" "$tag" >&2
                fail=1
            fi
            ;;
    esac
done
exit $fail
